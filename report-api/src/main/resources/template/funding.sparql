PREFIX : <https://nva.sikt.no/ontology/publication#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT
    ?publicationId
    ?status
    ?publicationIdentifier
    ?fundingSource
    ?fundingId
    ?fundingName
WHERE {
  GRAPH ?g {
    ?uri :status ?publicationStatus ;
         :modifiedDate ?modifiedDate ;
         :identifier ?publicationIdentifier ;
         :funding ?funding .

    FILTER(?publicationIdentifier > "__CURSOR__")
    FILTER(?modifiedDate >= "__AFTER__"^^xsd:dateTime)
    FILTER(?modifiedDate < "__BEFORE__"^^xsd:dateTime)

    BIND(STR(?uri) AS ?publicationId)
    BIND(REPLACE(STR(?publicationStatus), "^.*/([^/]*)$", "$1") AS ?status)

    ?funding :fundingSource ?fundingSource .
    ?funding :identifier ?fundingId .
    ?funding :label ?label .
    FILTER(LANG(?label) = "en")
    BIND(STR(?label) AS ?fundingName)
  }
} ORDER BY ASC(?publicationIdentifier) LIMIT __PAGE_SIZE__